# Linux ARM64 构建使用的平台专属 OCI manifest digest。
#
# allowlist 的 schema 名称是发布证据的一部分；审核镜像发生变化时必须提升版本，
# 重新执行 Linux ARM64 全门禁和 staging E2E，不能只把任意 digest 填到环境变量。
CONTAINER_IMAGE_ALLOWLIST_VERSION='environment-manager-linux-arm64-images-v1'
DEFAULT_RUST_RELEASE_IMAGE='docker.io/library/almalinux@sha256:2c999b3bd705fad8b115741d9036ae2499148ba162752f09f2f4ab62b0c07320'

# 数组中的每一项都必须是在权威 Ubuntu 24.04 ARM64 验证机上人工审核过的平台
# manifest。环境变量只能在本清单内选值，不能把“包含 sha256”误当成“已审核”。
AUDITED_RUST_RELEASE_IMAGES=(
  'docker.io/library/almalinux@sha256:2c999b3bd705fad8b115741d9036ae2499148ba162752f09f2f4ab62b0c07320'
)

# 判断镜像引用是否属于对应用途的版本化审核清单。
#
# 参数一是 `rust`，参数二是完整 OCI digest 引用。函数使用精确字符串
# 比较，既拒绝浮动 tag，也拒绝“同仓库但尚未审核”的其他 digest。
is_audited_container_image() {
  local purpose="$1"
  local candidate="$2"
  local -a allowed_images=()
  local allowed

  case "${purpose}" in
    rust) allowed_images=("${AUDITED_RUST_RELEASE_IMAGES[@]}") ;;
    *) return 2 ;;
  esac

  for allowed in "${allowed_images[@]}"; do
    if [[ "${candidate}" == "${allowed}" ]]; then
      return 0
    fi
  done
  return 1
}
