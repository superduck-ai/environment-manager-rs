# Go 行为基线的容器镜像必须固定到 Linux ARM64 平台 manifest，而不是可漂移 tag。
# tag 只用于人工追溯；构建脚本只使用带 sha256 digest 的 GO_ORACLE_IMAGE。
GO_ORACLE_IMAGE_TAG=docker.io/library/golang:1.25.7-bookworm
GO_ORACLE_IMAGE=docker.io/library/golang@sha256:f630c6aaf1842769464a1ddec76b2f5aff68783fe4479d4299ead44d8b488eb1
GO_ORACLE_PLATFORM=linux/arm64
