+func TestShouldPrepareCCRUpstreamProxyToken(t *testing.T) {
+	// 清空宿主环境，保证每个 case 只验证显式提供的配置优先级。
+	t.Setenv(claudeCodeRemoteEnvironmentKey, "")
+	t.Setenv(ccrUpstreamProxyEnabledEnvironmentKey, "")
+
+	for _, test := range []struct {
+		name           string
+		cfgEnvironment map[string]string
+		startup        *config.StartupContext
+		want           bool
+	}{
+		{
+			name: "enabled CCR v2 remote session",
+			cfgEnvironment: map[string]string{
+				claudeCodeRemoteEnvironmentKey: "true",
+			},
+			startup: &config.StartupContext{
+				UseCodeSessions: true,
+				EnvironmentVariables: map[string]string{
+					ccrUpstreamProxyEnabledEnvironmentKey: "1",
+				},
+			},
+			want: true,
+		},
+		{
+			name: "not a CCR v2 session",
+			cfgEnvironment: map[string]string{
+				claudeCodeRemoteEnvironmentKey:        "true",
+				ccrUpstreamProxyEnabledEnvironmentKey: "true",
+			},
+			startup: &config.StartupContext{},
+		},
+		{
+			name: "not remote",
+			cfgEnvironment: map[string]string{
+				ccrUpstreamProxyEnabledEnvironmentKey: "true",
+			},
+			startup: &config.StartupContext{UseCodeSessions: true},
+		},
+		{
+			name: "proxy disabled",
+			cfgEnvironment: map[string]string{
+				claudeCodeRemoteEnvironmentKey: "true",
+			},
+			startup: &config.StartupContext{UseCodeSessions: true},
+		},
+		{
+			name: "startup context overrides config",
+			cfgEnvironment: map[string]string{
+				claudeCodeRemoteEnvironmentKey:        "true",
+				ccrUpstreamProxyEnabledEnvironmentKey: "true",
+			},
+			startup: &config.StartupContext{
+				UseCodeSessions: true,
+				EnvironmentVariables: map[string]string{
+					ccrUpstreamProxyEnabledEnvironmentKey: "false",
+				},
+			},
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			executor := &ClaudeCodeExecutor{
+				cfg:            &config.ClaudeConfig{Environment: test.cfgEnvironment},
+				startupContext: test.startup,
+			}
+			if got := executor.shouldPrepareCCRUpstreamProxyToken(); got != test.want {
+				t.Fatalf("shouldPrepareCCRUpstreamProxyToken() = %t, want %t", got, test.want)
+			}
+		})
+	}
+}
