+func TestWriteCCRUpstreamProxyToken(t *testing.T) {
+	t.Parallel()
+
+	tokenDir := filepath.Join(t.TempDir(), "run", "ccr")
+	tokenPath := filepath.Join(tokenDir, "session_token")
+
+	if err := writeCCRUpstreamProxyToken(tokenPath, "first-token"); err != nil {
+		t.Fatalf("writeCCRUpstreamProxyToken() error = %v", err)
+	}
+	// 模拟上一次运行留下权限过宽的旧文件，验证原子替换会恢复为 0600。
+	if err := os.Chmod(tokenPath, 0o644); err != nil {
+		t.Fatalf("Chmod(%q) error = %v", tokenPath, err)
+	}
+	if err := writeCCRUpstreamProxyToken(tokenPath, "replacement-token"); err != nil {
+		t.Fatalf("writeCCRUpstreamProxyToken() replacement error = %v", err)
+	}
+
+	content, err := os.ReadFile(tokenPath)
+	if err != nil {
+		t.Fatalf("ReadFile(%q) error = %v", tokenPath, err)
+	}
+	if string(content) != "replacement-token" {
+		t.Fatalf("token content = %q, want %q", content, "replacement-token")
+	}
+
+	tokenInfo, err := os.Stat(tokenPath)
+	if err != nil {
+		t.Fatalf("Stat(%q) error = %v", tokenPath, err)
+	}
+	if got := tokenInfo.Mode().Perm(); got != 0o600 {
+		t.Fatalf("token mode = %o, want 600", got)
+	}
+
+	dirInfo, err := os.Stat(tokenDir)
+	if err != nil {
+		t.Fatalf("Stat(%q) error = %v", tokenDir, err)
+	}
+	if got := dirInfo.Mode().Perm(); got != 0o700 {
+		t.Fatalf("token directory mode = %o, want 700", got)
+	}
+
+	// 成功路径也不能遗留包含敏感 token 的临时文件。
+	temporaryFiles, err := filepath.Glob(filepath.Join(tokenDir, ".session_token-*"))
+	if err != nil {
+		t.Fatalf("Glob() error = %v", err)
+	}
+	if len(temporaryFiles) != 0 {
+		t.Fatalf("temporary token files remain: %v", temporaryFiles)
+	}
+}
