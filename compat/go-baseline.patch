+func isTruthyEnvironmentValue(value string) bool {
+	// 与 Claude/SuperDuck 的布尔环境变量语义保持一致，兼容部署系统常见写法。
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "1", "true", "yes", "on":
+		return true
+	default:
+		return false
+	}
+}
+
+func (e *ClaudeCodeExecutor) effectiveEnvironmentValue(key string) string {
+	// 环境变量有三层来源。越靠近本次任务的配置优先级越高：
+	// 宿主进程环境 < ClaudeConfig < StartupContext。
+	// 这样服务端可以针对单个 session 明确开启或关闭 relay，而不会被镜像默认值覆盖。
+	value := os.Getenv(key)
+	if e.cfg != nil {
+		if configured, ok := e.cfg.Environment[key]; ok {
+			value = configured
+		}
+	}
+	if e.startupContext != nil {
+		if configured, ok := e.startupContext.EnvironmentVariables[key]; ok {
+			value = configured
+		}
+	}
+	return value
+}
+
+func (e *ClaudeCodeExecutor) shouldPrepareCCRUpstreamProxyToken() bool {
+	// token 文件只服务于远程 code-session 的 CCRv2 upstream proxy。
+	// 对本地测试、普通 Claude 调用或未开启代理的任务写入该文件，既没有意义，
+	// 也会无谓地扩大 SessionIngressAuthToken 在磁盘上的暴露时间。
+	return e.startupContext != nil &&
+		e.startupContext.UseCodeSessions &&
+		isTruthyEnvironmentValue(e.effectiveEnvironmentValue(claudeCodeRemoteEnvironmentKey)) &&
+		isTruthyEnvironmentValue(e.effectiveEnvironmentValue(ccrUpstreamProxyEnabledEnvironmentKey))
+}
+
+func writeCCRUpstreamProxyToken(path string, token string) error {
+	if path == "" {
+		return errors.New("CCR upstream proxy token path is empty")
+	}
+	if token == "" {
+		return errors.New("CCR upstream proxy token is empty")
+	}
+
+	// /run/ccr 只允许当前容器用户进入，token 文件本身只允许当前用户读写。
+	// 即使基础镜像预先创建过权限较宽的目录，也主动收紧为 0700。
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return fmt.Errorf("failed to create CCR upstream proxy token directory: %w", err)
+	}
+	if err := os.Chmod(dir, 0o700); err != nil {
+		return fmt.Errorf("failed to secure CCR upstream proxy token directory: %w", err)
+	}
+
+	// 先在同一目录写临时文件，再 rename 到固定路径。rename 在同一文件系统内是
+	// 原子操作，Claude relay 不会观察到半写入 token，也不会读取到上一次任务的残留内容。
+	temporary, err := os.CreateTemp(dir, ".session_token-*")
+	if err != nil {
+		return fmt.Errorf("failed to create temporary CCR upstream proxy token file: %w", err)
+	}
+	temporaryPath := temporary.Name()
+	closed := false
+	defer func() {
+		// 任意失败路径都关闭文件并清除临时文件；成功 rename 后 Remove 是无害的。
+		if !closed {
+			_ = temporary.Close()
+		}
+		_ = os.Remove(temporaryPath)
+	}()
+
+	if err := temporary.Chmod(0o600); err != nil {
+		return fmt.Errorf("failed to secure temporary CCR upstream proxy token file: %w", err)
+	}
+	if _, err := temporary.WriteString(token); err != nil {
+		return fmt.Errorf("failed to write temporary CCR upstream proxy token file: %w", err)
+	}
+	if err := temporary.Close(); err != nil {
+		return fmt.Errorf("failed to close temporary CCR upstream proxy token file: %w", err)
+	}
+	closed = true
+	if err := os.Rename(temporaryPath, path); err != nil {
+		return fmt.Errorf("failed to install CCR upstream proxy token file: %w", err)
+	}
+	return nil
+}
